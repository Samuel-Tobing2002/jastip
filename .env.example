# Frontend API endpoint (Vite exposes VITE_* variables to the browser)
VITE_API_URL=http://localhost:4000

# Backend
PORT=4000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_TOKEN=replace-with-a-long-random-token
# Comma-separated origins allowed to call the backend locally
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Supabase (backend only; never use VITE_ prefix for the secret)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-new-secret-key

# Cloudinary unsigned upload
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_UPLOAD_PRESET=jastip_products

# Optional local fallback paths
DATA_DIR=./backend/data
UPLOAD_DIR=./public/uploads
